{
  // The shared app settings (@jwill89/lint-web): Vue's DOM base, unused locals and
  // parameters, switch fallthrough, and an index that may find nothing typed as such. The
  // kit's own code and the playground, which imports the kit by its package name as an app
  // does; the path below points that name at the source.
  "extends": "@jwill89/lint-web/tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@jwill89/shared-components-vue": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue"
  ],
  "exclude": ["src/__tests__/**", "playground/vite.config.ts"]
}
