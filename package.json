{
  "name": "@jwill89/shared-components-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared Vue 3 components on Reka UI, styled only through design tokens, for jwill89's front ends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwill89/shared-components-vue.git"
  },
  "engines": {
    "node": ">=26"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:playground": "vite build --config playground/vite.config.ts",
    "prepare": "npm run build",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\" \"playground/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" \"playground/**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "dependencies": {
    "reka-ui": "2.11.0"
  },
  "devDependencies": {
    "@jwill89/lint-web": "file:shared/lint/web",
    "@jwill89/test-a11y": "file:shared/test/a11y",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.2"
    }
  }
}
